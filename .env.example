# Configuration Gemini (côté serveur uniquement - ne jamais exposer dans Vite/client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Optionnel : hôte d'écoute (127.0.0.1 par défaut en local) et origines autorisées séparées par des virgules
# HOST=127.0.0.1
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
